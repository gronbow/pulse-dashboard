{
  "name": "pulse-dashboard",
  "version": "0.5.6",
  "productName": "Pulse Dashboard",
  "description": "A privacy-first, Codex-hosted health and training desktop dashboard with compact widget layouts.",
  "author": "Qin Lipeng",
  "main": "src/main.js",
  "private": true,
  "pulse": {
    "releaseChannel": "beta",
    "handoffProtocolVersion": 2
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "app.pulse.dashboard",
    "artifactName": "Pulse-Dashboard-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "bridge/codex-handoff-server.js",
      "scripts/handoff-auth.js",
      "scripts/snapshot-policy.js",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "pulse-tray.ico"
      },
      {
        "from": "build/tray-icon.png",
        "to": "pulse-tray.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "start": "electron .",
    "generate:icons": "node scripts/generate-icons.js",
    "check": "node scripts/validate.js",
    "version:set": "node scripts/set-release-version.js",
    "audit:public": "node scripts/audit-public-repo.js",
    "audit:history": "node scripts/audit-git-history.js --ref HEAD",
    "audit:history:all": "node scripts/audit-git-history.js --all",
    "audit:dependencies": "npm audit --package-lock-only --audit-level=high",
    "audit:production": "npm audit --package-lock-only --omit=dev --audit-level=high",
    "bridge:demo": "node bridge/mock-server.js",
    "bridge:codex": "node bridge/codex-handoff-server.js",
    "test": "npm run check && npm run test:release-contract && npm run test:workflows && npm run test:release-metadata && npm run audit:public && npm run test:public-plugin && npm run test:history-audit-cli && npm run test:snapshot && npm run test:data-trust && npm run test:safety-presentation && npm run test:snapshot-policy && npm run test:adapter && npm run test:bridge && npm run test:local-security && npm run test:codex-handoff && npm run test:publisher && npm run test:tray && npm run test:window-icon",
    "test:bridge": "node scripts/test-bridge.js",
    "test:snapshot": "node scripts/test-snapshot.js",
    "test:data-trust": "node scripts/test-data-trust.js",
    "test:safety-presentation": "node scripts/test-safety-presentation.js",
    "test:adapter": "node scripts/test-adapter.js",
    "test:codex-handoff": "node scripts/test-codex-handoff.js",
    "test:local-security": "node scripts/test-local-security.js",
    "test:snapshot-policy": "node scripts/test-snapshot-policy.js",
    "test:publisher": "node scripts/test-publish-snapshot.js",
    "test:public-plugin": "node scripts/test-public-plugin.js",
    "test:tray": "node scripts/test-tray-icon.js",
    "test:window-icon": "node scripts/test-window-icon.js",
    "test:packaged": "node scripts/test-tray-icon.js --packaged && node scripts/test-window-icon.js --packaged && node scripts/test-electron-fuses.js",
    "test:history-audit-cli": "node scripts/test-audit-git-history.js",
    "test:release-contract": "node scripts/test-release-contract.js",
    "test:release-metadata": "node scripts/test-release-metadata.js",
    "test:workflows": "node scripts/test-workflows.js",
    "test:desktop": "node scripts/test-electron-smoke.js",
    "test:compact-mode": "node scripts/test-compact-mode.js",
    "test:secondary-health": "node scripts/test-secondary-health-card.js",
    "test:unavailable": "node scripts/test-unavailable-state.js",
    "test:renderer-safety": "electron scripts/test-renderer-safety.js",
    "test:safety-states": "node scripts/test-safety-states.js",
    "test:ui": "npm run test:ui-contract && npm run test:renderer-safety && npm run test:desktop && npm run test:safety-states && npm run test:data-trust-rendering && npm run test:compact-mode && npm run test:ui-layout && npm run test:secondary-health && npm run test:unavailable",
    "test:ui-contract": "node scripts/test-ui-contract.js",
    "test:data-trust-rendering": "node scripts/test-data-trust-rendering.js",
    "test:ui-layout": "node scripts/test-ui-layout.js",
    "test:ci": "npm test && npm run audit:history && npm run test:ui && npm run audit:dependencies && npm run audit:production",
    "test:release": "npm run test:ci && npm run test:packaged",
    "release:checksums": "node scripts/generate-release-checksums.js",
    "prepack:win": "npm run generate:icons",
    "pack:win": "electron-builder --dir --win --x64",
    "predist:win": "npm run generate:icons",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
